PORT=3000
CLIENT_ORIGIN=http://localhost:5173
# Nombre de joueurs max par salon (hôte inclus), défaut 5.
MAX_PLAYERS=5
# Durée de vie d'un salon en secondes (défaut 6h).
ROOM_TTL_SECONDS=21600
# Stockage partagé pour Vercel (Upstash Redis) — requis en production serverless.
# Sans ces 2 variables, repli mémoire (dev local uniquement).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
